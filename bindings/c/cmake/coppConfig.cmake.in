@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set_and_check(COPP_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set_and_check(COPP_LIBRARY_LOCATION "${PACKAGE_PREFIX_DIR}/@COPP_CONFIG_LOCATION_RELPATH@")

if("@COPP_CONFIG_IMPLIB_RELPATH@" STREQUAL "")
    set(COPP_IMPORT_LIBRARY "")
else()
    set_and_check(COPP_IMPORT_LIBRARY "${PACKAGE_PREFIX_DIR}/@COPP_CONFIG_IMPLIB_RELPATH@")
endif()

if("@COPP_CONFIG_IS_STATIC@" STREQUAL "ON")
    find_dependency(Threads)
endif()

if(NOT TARGET copp::copp)
    add_library(copp::copp @COPP_CONFIG_TARGET_TYPE@ IMPORTED)
    set_target_properties(copp::copp PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${COPP_INCLUDE_DIR}"
    )

    if(COPP_IMPORT_LIBRARY)
        set_target_properties(copp::copp PROPERTIES
            IMPORTED_IMPLIB "${COPP_IMPORT_LIBRARY}"
            IMPORTED_LOCATION "${COPP_LIBRARY_LOCATION}"
        )
    else()
        set_target_properties(copp::copp PROPERTIES
            IMPORTED_LOCATION "${COPP_LIBRARY_LOCATION}"
        )
    endif()

    if("@COPP_CONFIG_IS_STATIC@" STREQUAL "ON")
        set(COPP_STATIC_LINK_LIBRARIES "@COPP_CONFIG_STATIC_LINK_LIBRARIES@")
        if(COPP_STATIC_LINK_LIBRARIES)
            set_property(TARGET copp::copp APPEND PROPERTY
                INTERFACE_LINK_LIBRARIES ${COPP_STATIC_LINK_LIBRARIES}
            )
        endif()

        set(COPP_STATIC_LINK_OPTIONS "@COPP_CONFIG_STATIC_LINK_OPTIONS@")
        if(COPP_STATIC_LINK_OPTIONS)
            set_property(TARGET copp::copp APPEND PROPERTY
                INTERFACE_LINK_OPTIONS ${COPP_STATIC_LINK_OPTIONS}
            )
        endif()
    endif()
endif()

check_required_components(copp)
